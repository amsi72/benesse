<style>
/* ═══════════════════════════════════════
   DESIGN TOKENS — LIGHT MODE (default)
═══════════════════════════════════════ */
:root {
  --purple:        #5B1FA3;
  --purple-deep:   #3D1570;
  --purple-light:  #7B3FC4;
  --purple-soft:   #8B5CC4;
  --lilac:         #C4A8E8;
  --lilac-pale:    #EDE4F8;
  --lilac-faint:   #F4EEFB;
  --rose:          #EDD0E2;
  --rose-soft:     #FAF0F5;
  --gold:          #B8943A;

  /* backgrounds */
  --bg-page:       #FDFBFF;
  --bg-surface:    #FFFFFF;
  --bg-subtle:     #F7F2FD;
  --bg-dark:       #140C24;
  --bg-dark-2:     #1E1035;

  /* text — WCAG AA compliant */
  --tx-heading:    #120A22;
  --tx-body:       #2C1F42;
  --tx-secondary:  #533E6E;
  --tx-muted:      #7A6592;
  --tx-faint:      #A694BF;
  --tx-on-dark:    #F0E8FF;
  --tx-on-dark-2:  #C8B8E8;
  --tx-on-dark-3:  #8E7AB0;

  /* borders */
  --border:        rgba(91,31,163,0.10);
  --border-dark:   rgba(196,168,232,0.15);

  /* shadows */
  --sh-sm:  0 2px 16px rgba(91,31,163,0.07);
  --sh-md:  0 8px 40px rgba(91,31,163,0.11);
  --sh-lg:  0 24px 80px rgba(91,31,163,0.15);

  /* header */
  --hdr-bg:        transparent;
  --hdr-scrolled:  rgba(255,255,255,0.97);
  --hdr-shadow:    0 1px 30px rgba(91,31,163,0.09);
  --hdr-nav-color: #3B2A55;
  --hdr-logo-filter: none;

  /* mobile menu */
  --mm-bg: rgba(255,255,255,0.99);
  --mm-link: #120A22;

  /* cards */
  --card-bg:       #FFFFFF;
  --card-border:   rgba(91,31,163,0.09);
  --card-hover-bg: #FAF6FF;

  /* contact cards */
  --cc-bg:         #F7F2FD;
  --cc-hover:      #EDE4F8;
}

/* ═══════════════════════════════════════
   DARK MODE OVERRIDES
═══════════════════════════════════════ */
@media (prefers-color-scheme: dark) {
  :root {
    --purple:        #9B6FD4;
    --purple-deep:   #7B4FC4;
    --purple-light:  #B090E0;
    --purple-soft:   #A880D8;
    --lilac:         #C4A8E8;
    --lilac-pale:    #2A1850;
    --lilac-faint:   #1E1238;
    --rose:          #2A1830;
    --rose-soft:     #1E1230;
    --gold:          #D4A84C;

    --bg-page:       #0E0820;
    --bg-surface:    #160E2C;
    --bg-subtle:     #1C1238;
    --bg-dark:       #0A0618;
    --bg-dark-2:     #120A24;

    --tx-heading:    #F0E8FF;
    --tx-body:       #D8CCF0;
    --tx-secondary:  #B8A8D8;
    --tx-muted:      #907898;
    --tx-faint:      #604870;
    --tx-on-dark:    #F0E8FF;
    --tx-on-dark-2:  #C8B0E8;
    --tx-on-dark-3:  #806898;

    --border:        rgba(196,168,232,0.12);
    --border-dark:   rgba(196,168,232,0.18);

    --sh-sm:  0 2px 16px rgba(0,0,0,0.4);
    --sh-md:  0 8px 40px rgba(0,0,0,0.5);
    --sh-lg:  0 24px 80px rgba(0,0,0,0.6);

    --hdr-bg:        transparent;
    --hdr-scrolled:  rgba(14,8,32,0.97);
    --hdr-shadow:    0 1px 30px rgba(0,0,0,0.4);
    --hdr-nav-color: #C8B8E8;
    --hdr-logo-filter: brightness(0) invert(1) opacity(0.9);

    --mm-bg: rgba(14,8,32,0.99);
    --mm-link: #F0E8FF;

    --card-bg:       #1C1238;
    --card-border:   rgba(196,168,232,0.10);
    --card-hover-bg: #231648;

    --cc-bg:         #1C1238;
    --cc-hover:      #261A48;
  }
}

/* ═══════════════════════════════════════
   RESET & BASE
═══════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }

body {
  font-family: 'Jost', system-ui, sans-serif;
  background: var(--bg-page);
  color: var(--tx-body);
  overflow-x: hidden;
  font-size: 16px;
  line-height: 1.6;
}

img { max-width: 100%; display: block; }
a { color: inherit; }

h1, h2, h3, h4 {
  font-family: 'Playfair Display', Georgia, serif;
  color: var(--tx-heading);
  line-height: 1.2;
}

/* ═══════════════════════════════════════
   HEADER
═══════════════════════════════════════ */
#header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  padding: 18px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--hdr-bg);
  transition: background 0.45s ease, box-shadow 0.45s ease, padding 0.35s ease;
}

#header.scrolled {
  background: var(--hdr-scrolled);
  box-shadow: var(--hdr-shadow);
  padding: 12px 5%;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.hdr-logo img {
  height: 52px;
  width: auto;
  transition: height 0.35s ease;
  filter: var(--hdr-logo-filter);
}
#header.scrolled .hdr-logo img { height: 40px; }

/* header nav — desktop only */
.hdr-nav {
  display: flex;
  align-items: center;
  gap: 32px;
}

.hdr-nav a {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.13em;
  text-transform: uppercase;
  color: var(--hdr-nav-color);
  text-decoration: none;
  position: relative;
  transition: color 0.3s;
}
.hdr-nav a::after {
  content: '';
  position: absolute;
  bottom: -4px; left: 0;
  width: 0; height: 1px;
  background: var(--purple);
  transition: width 0.3s;
}
.hdr-nav a:hover { color: var(--purple); }
.hdr-nav a:hover::after { width: 100%; }

.btn-pill {
  display: inline-block;
  font-family: 'Jost', sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #fff;
  background: var(--purple);
  border: none;
  padding: 11px 22px;
  border-radius: 50px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
  box-shadow: 0 4px 18px rgba(91,31,163,0.30);
  white-space: nowrap;
}
.btn-pill:hover {
  background: var(--purple-deep);
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(91,31,163,0.42);
}

/* ═══════════════════════════════════════
   HAMBURGER
═══════════════════════════════════════ */
.hamburger {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 6px;
  cursor: pointer;
  padding: 6px;
  background: none;
  border: none;
  z-index: 201;
}
.hamburger span {
  display: block;
  width: 26px; height: 2px;
  background: var(--purple);
  border-radius: 2px;
  transition: all 0.3s ease;
}
.hamburger.open span:nth-child(1) { transform: rotate(45deg) translate(5px,5px); }
.hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.hamburger.open span:nth-child(3) { transform: rotate(-45deg) translate(5px,-5px); }

/* ═══════════════════════════════════════
   MOBILE OVERLAY MENU
═══════════════════════════════════════ */
.mobile-overlay {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 199;
  background: var(--mm-bg);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  opacity: 0;
  transition: opacity 0.35s ease;
}
.mobile-overlay.open { display: flex; opacity: 1; }

.mobile-overlay a {
  font-family: 'Playfair Display', serif;
  font-size: clamp(26px, 6vw, 34px);
  font-weight: 400;
  color: var(--mm-link);
  text-decoration: none;
  padding: 14px 0;
  transition: color 0.3s;
}
.mobile-overlay a:hover { color: var(--purple); }

.mobile-overlay .mobile-sep {
  width: 40px; height: 1px;
  background: var(--border);
  margin: 6px 0;
}

.mobile-overlay .btn-pill {
  margin-top: 24px;
  font-size: 13px;
  padding: 14px 32px;
}

/* ═══════════════════════════════════════
   SECTION UTILITIES
═══════════════════════════════════════ */
.section-wrap { padding: 96px 5%; }
.container    { max-width: 1200px; margin: 0 auto; }
.container-sm { max-width: 860px;  margin: 0 auto; }

.label-tag {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.20em;
  text-transform: uppercase;
  color: var(--purple-soft);
  margin-bottom: 14px;
}
.label-tag::before {
  content: '';
  display: block;
  width: 24px; height: 1.5px;
  background: var(--purple-soft);
  flex-shrink: 0;
}

/* ═══════════════════════════════════════
   SCROLL REVEAL
═══════════════════════════════════════ */
.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.75s ease, transform 0.75s ease;
}
.reveal.in { opacity: 1; transform: translateY(0); }
.delay-1 { transition-delay: 0.10s; }
.delay-2 { transition-delay: 0.20s; }
.delay-3 { transition-delay: 0.30s; }
.delay-4 { transition-delay: 0.40s; }
.delay-5 { transition-delay: 0.50s; }

/* ═══════════════════════════════════════
   HERO
═══════════════════════════════════════ */
.hero {
  min-height: 100svh;
  display: flex;
  align-items: center;
  padding: 110px 5% 72px;
  position: relative;
  overflow: hidden;
  background: linear-gradient(140deg, var(--bg-page) 0%, var(--lilac-faint) 55%, var(--rose-soft) 100%);
}

/* animated orbs */
.orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(72px);
}
.orb-1 {
  width: min(560px,90vw); height: min(560px,90vw);
  top: -140px; right: -80px;
  background: radial-gradient(circle, rgba(180,140,230,0.32) 0%, transparent 68%);
  animation: orb1 14s ease-in-out infinite;
}
.orb-2 {
  width: min(380px,70vw); height: min(380px,70vw);
  bottom: -80px; left: -80px;
  background: radial-gradient(circle, rgba(220,180,215,0.38) 0%, transparent 68%);
  animation: orb2 17s ease-in-out infinite;
}
.orb-3 {
  width: min(260px,50vw); height: min(260px,50vw);
  top: 45%; left: 42%;
  background: radial-gradient(circle, rgba(201,168,76,0.08) 0%, transparent 68%);
  animation: orb3 20s ease-in-out infinite;
}
@keyframes orb1 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-28px,18px)} }
@keyframes orb2 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(22px,-26px)} }
@keyframes orb3 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(-16px,16px)} }

@media (prefers-color-scheme: dark) {
  .orb-1 { background: radial-gradient(circle, rgba(120,60,200,0.25) 0%, transparent 68%); }
  .orb-2 { background: radial-gradient(circle, rgba(100,40,120,0.22) 0%, transparent 68%); }
}

.hero-grid {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;
}

/* hero left */
.hero-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--purple);
  background: rgba(91,31,163,0.08);
  border: 1px solid rgba(91,31,163,0.14);
  padding: 7px 16px;
  border-radius: 50px;
  margin-bottom: 24px;
  opacity: 0;
  animation: fadeUp 0.7s ease 0.15s forwards;
}
@media (prefers-color-scheme: dark) {
  .hero-chip {
    color: var(--lilac);
    background: rgba(196,168,232,0.10);
    border-color: rgba(196,168,232,0.18);
  }
}
.hero-chip i {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--purple);
  display: inline-block;
  flex-shrink: 0;
}

.hero-h1 {
  font-size: clamp(34px, 4.5vw, 60px);
  font-weight: 500;
  line-height: 1.13;
  letter-spacing: -0.015em;
  color: var(--tx-heading);
  margin-bottom: 22px;
  opacity: 0;
  animation: fadeUp 0.7s ease 0.3s forwards;
}
.hero-h1 em {
  font-style: italic;
  color: var(--purple);
  font-weight: 400;
}

.hero-sub {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(17px, 2.2vw, 21px);
  font-weight: 400;
  line-height: 1.72;
  color: var(--tx-secondary);
  margin-bottom: 36px;
  opacity: 0;
  animation: fadeUp 0.7s ease 0.45s forwards;
}

.hero-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 32px;
  opacity: 0;
  animation: fadeUp 0.7s ease 0.6s forwards;
}

.btn-outline {
  display: inline-block;
  font-family: 'Jost', sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--purple);
  border: 1.5px solid rgba(91,31,163,0.28);
  padding: 11px 22px;
  border-radius: 50px;
  text-decoration: none;
  transition: all 0.3s;
}
.btn-outline:hover {
  border-color: var(--purple);
  background: rgba(91,31,163,0.05);
  transform: translateY(-2px);
}
@media (prefers-color-scheme: dark) {
  .btn-outline {
    color: var(--lilac);
    border-color: rgba(196,168,232,0.30);
  }
  .btn-outline:hover {
    border-color: var(--lilac);
    background: rgba(196,168,232,0.08);
  }
}

.hero-crp {
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--tx-muted);
  opacity: 0;
  animation: fadeUp 0.7s ease 0.75s forwards;
}

/* hero right — photo */
.hero-photo-col {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  animation: fadeIn 1.1s ease 0.4s forwards;
}

.photo-frame {
  position: relative;
  width: 100%;
  max-width: 440px;
}

.photo-blob {
  position: absolute;
  inset: 0;
  background: linear-gradient(150deg, var(--lilac-pale) 0%, var(--rose) 55%, var(--lilac-faint) 100%);
  border-radius: 62% 38% 52% 48% / 60% 48% 52% 40%;
  transform: scale(1.09) rotate(-2.5deg);
}

.photo-ring-1 {
  position: absolute;
  inset: -18px;
  border-radius: 60% 40% 54% 46% / 58% 46% 54% 42%;
  border: 1px solid rgba(91,31,163,0.12);
  transform: scale(1.13) rotate(3deg);
}

.photo-ring-2 {
  position: absolute;
  inset: -36px;
  border-radius: 56% 44% 56% 44% / 56% 44% 56% 44%;
  border: 1px solid rgba(201,168,76,0.14);
  transform: scale(1.17) rotate(-4deg);
}

.photo-img {
  position: relative;
  z-index: 2;
  width: 100%;
  filter: drop-shadow(0 22px 56px rgba(91,31,163,0.16));
}

.photo-badge {
  position: absolute;
  bottom: 26px; left: -16px;
  z-index: 3;
  background: var(--bg-surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 13px 18px;
  box-shadow: var(--sh-md);
  animation: float 7s ease-in-out infinite;
}
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-9px)} }

.badge-name {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.11em;
  text-transform: uppercase;
  color: var(--purple);
}
.badge-sub {
  font-family: 'Cormorant Garamond', serif;
  font-size: 13px;
  color: var(--tx-secondary);
  margin-top: 2px;
}

@keyframes fadeUp  { from{opacity:0;transform:translateY(22px)} to{opacity:1;transform:translateY(0)} }
@keyframes fadeIn  { from{opacity:0} to{opacity:1} }

/* ═══════════════════════════════════════
   APRESENTAÇÃO
═══════════════════════════════════════ */
.sec-apresentacao {
  background: var(--bg-surface);
}
.apresentacao-grid {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 72px;
  align-items: start;
}
.apresentacao-title {
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 500;
  letter-spacing: -0.015em;
  color: var(--tx-heading);
  position: sticky;
  top: 110px;
}
.apresentacao-title em { display: block; font-style: italic; color: var(--purple); font-weight: 400; }

.divider-line {
  width: 40px; height: 1.5px;
  background: linear-gradient(to right, var(--purple), var(--lilac));
  margin: 20px 0 0;
}

.prose p {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(18px, 2.2vw, 22px);
  font-weight: 400;
  line-height: 1.78;
  color: var(--tx-secondary);
  margin-bottom: 20px;
}
.prose p:last-child { margin-bottom: 0; }

/* ═══════════════════════════════════════
   TRAJETÓRIA
═══════════════════════════════════════ */
.sec-trajetoria {
  background: linear-gradient(155deg, var(--lilac-faint) 0%, var(--bg-page) 100%);
}
.trajetoria-head {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: end;
  margin-bottom: 48px;
}
.trajetoria-head h2 {
  font-size: clamp(38px, 5vw, 58px);
  font-weight: 500;
  letter-spacing: -0.02em;
}
.trajetoria-head p {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(18px, 2.2vw, 21px);
  font-weight: 400;
  line-height: 1.72;
  color: var(--tx-secondary);
}
.trajetoria-body .prose p { font-size: clamp(17px, 2vw, 20px); }

/* ═══════════════════════════════════════
   HISTÓRIA
═══════════════════════════════════════ */
.sec-historia { background: var(--bg-surface); }
.historia-grid {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 72px;
  align-items: start;
}
.historia-sidebar {
  position: sticky;
  top: 110px;
}
.historia-sidebar h2 {
  font-size: clamp(32px, 3.8vw, 46px);
  font-weight: 500;
  letter-spacing: -0.01em;
  margin-bottom: 20px;
}
.historia-ornament {
  width: 48px; height: 48px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--lilac-pale), var(--rose));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20px;
}
.historia-ornament svg { width: 22px; height: 22px; }
@media (prefers-color-scheme: dark) {
  .historia-ornament { background: linear-gradient(135deg, #2A1850, #3A1830); }
  .historia-ornament svg { fill: var(--lilac); }
}

/* ═══════════════════════════════════════
