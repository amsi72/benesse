═══════════════════════════════════════ */
.wa-float {
  position: fixed;
  bottom: 28px; right: 28px;
  z-index: 190;
  width: 58px; height: 58px;
  background: #22C55E;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6px 28px rgba(34,197,94,0.40);
  text-decoration: none;
  transition: transform 0.3s, box-shadow 0.3s;
  animation: waPulse 3.5s ease-in-out infinite;
}
.wa-float:hover {
  transform: scale(1.10);
  box-shadow: 0 10px 40px rgba(34,197,94,0.55);
  animation: none;
}
.wa-float svg { width: 30px; height: 30px; fill: #fff; }
@keyframes waPulse {
  0%,100% { box-shadow: 0 6px 28px rgba(34,197,94,0.40); }
  50% { box-shadow: 0 6px 44px rgba(34,197,94,0.60), 0 0 0 10px rgba(34,197,94,0.09); }
